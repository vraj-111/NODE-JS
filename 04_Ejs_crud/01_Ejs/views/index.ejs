<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student List</title>
</head>
<body>

    <h1>Student List</h1>

    <a href="/add">Add Student</a>

    <ul>

        <% StudentList.forEach((student) => { %>

            <li>
                <%= student.name %>

                <a href="/edit/<%= student.id %>">
                    Edit
                </a>

                <a href="/delete/<%= student.id %>">
                    Delete
                </a>
            </li>

        <% }) %>

    </ul>

</body>
</html>